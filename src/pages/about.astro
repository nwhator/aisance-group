---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';

const seoTitle = 'About Aisance Group | Institutional Heritage & Vision';
const seoDescription = 'Learn about Aisance Group, a distinguished Nigerian parent holding established to deliver everyday solutions with uncompromising standards across five core divisions.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About Us' },
];

const values = [
  {
    num: '01',
    title: 'Unwavering Integrity',
    desc: 'Absolute clarity and accountability in billing, scope, and personnel conduct. Every service engagement is backed by formal commitments.',
    icon: 'verified_user',
  },
  {
    num: '02',
    title: 'Institutional Rigor',
    desc: 'Hospital-grade sanitization protocols, calibrated chemistries, and strict biometric chain-of-custody governing every single assignment.',
    icon: 'military_tech',
  },
  {
    num: '03',
    title: 'Discreet Stewardship',
    desc: 'Profound respect for client privacy, private residences, and sensitive corporate materials under strict non-disclosure governance.',
    icon: 'shield',
  },
  {
    num: '04',
    title: 'Sustainable Sourcing',
    desc: 'Empowering Nigerian agriculture, cold-pressed raw botanicals, and regional farming cooperatives across our production pipelines.',
    icon: 'eco',
  },
];

const divisions = [
  {
    num: '01',
    name: 'Toiletries Production',
    desc: 'Handcrafted organic botanical soaps, skin-safe personal care, and institutional amenities.',
    href: '/services/toiletries-production',
  },
  {
    num: '02',
    name: 'Home & Commercial Cleaning',
    desc: 'Hospital-grade deep sanitization, post-construction care, and residential estate housekeeping.',
    href: '/services/cleaning',
  },
  {
    num: '03',
    name: 'Dry Cleaning Services',
    desc: 'Master garment care, couture pressing, and traditional fabric restoration.',
    href: '/services/dry-cleaning',
  },
  {
    num: '04',
    name: 'Food Thrift',
    desc: 'Farm-direct staple provisions, wholesale grains, and curated household pantry baskets.',
    href: '/services/food-thrift',
  },
  {
    num: '05',
    name: 'Errand & Logistics',
    desc: 'Discreet personal concierge errands, secure document dispatch, and time-critical couriers.',
    href: '/services/errand-logistics',
  },
];
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <!-- Editorial Hero Section -->
  <section class="relative w-full overflow-hidden bg-[#FCF9F8] pb-16 pt-8 lg:pt-12">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <!-- Top Eyebrow & Breadcrumbs Row -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-8">
        <Breadcrumbs items={breadcrumbs} />
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#EAE7E7] text-[#12372A] border border-[#DDE7E1]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C9A24A]"></span>
          <span class="font-sans text-xs uppercase tracking-widest text-[#414844] font-semibold">Holding Group Standard</span>
        </div>
      </div>

      <!-- Asymmetrical Editorial Split Headline -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end pb-12">
        <div class="lg:col-span-8">
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-[60px] lg:leading-[68px] text-[#12372A] tracking-tight font-normal">
            Built Around Service.<br />
            <span class="italic font-normal text-[#C9A24A]">Driven by Unyielding Quality.</span>
          </h1>
        </div>
        <div class="lg:col-span-4 lg:pb-2">
          <p class="font-sans text-base sm:text-lg text-[#414844] leading-relaxed">
            Aisance Group was established to elevate everyday Nigerian life through uncompromising standards of excellence. From artisanal toiletries to bespoke garment preservation and discreet courier logistics, we bring sovereign institutional rigor to personal domestic tranquility and enterprise operations.
          </p>
        </div>
      </div>

      <!-- Visual Architectural & Heritage Mosaic -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        <div class="lg:col-span-7 relative group rounded-2xl overflow-hidden shadow-xl bg-[#EAE7E7] min-h-[380px] lg:min-h-[440px] border border-[#DDE7E1]">
          <img
            src="/images/cleaning.png"
            alt="Aisance Group sovereign living standard and architectural sanctuary"
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            width="700"
            height="440"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#12372A]/85 via-[#12372A]/25 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-8 flex flex-col justify-end text-[#FCF9F8]">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-[#FFDF9E] text-lg">verified</span>
              <span class="font-sans text-xs uppercase tracking-widest text-[#FFDF9E] font-bold">Sovereign Living Standards</span>
            </div>
            <p class="font-serif text-xl sm:text-2xl max-w-lg leading-snug">
              Elevating Nigerian households &amp; corporate estates into bastions of order, cleanliness, and ease.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5 flex flex-col gap-6">
          <div class="relative flex-1 rounded-2xl overflow-hidden shadow-md bg-[#12372A] min-h-[220px] p-8 flex flex-col justify-between text-[#FCF9F8] border border-[#C9A24A]/40">
            <span class="font-sans text-xs uppercase tracking-widest text-[#FFDF9E] font-bold">Craftsmanship &amp; Chemistry</span>
            <div>
              <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-white">Artisanal Formulation</h2>
              <p class="font-sans text-sm text-[#A8CFBD] mt-2 max-w-xs leading-relaxed">
                Small-batch botanicals and rigorous hypoallergenic cleaning chemistry crafted for high-touch environments.
              </p>
            </div>
          </div>

          <div class="bg-[#FFFFFF] p-6 rounded-2xl shadow-sm border border-[#DDE7E1] flex flex-col justify-between gap-4">
            <div class="flex items-center justify-between">
              <span class="font-sans text-xs uppercase tracking-widest text-[#414844] font-semibold">Institutional Governance</span>
              <span class="material-symbols-outlined text-[#C9A24A] text-xl">gavel</span>
            </div>
            <div class="grid grid-cols-2 gap-4 pt-2">
              <div>
                <span class="font-serif text-3xl font-bold text-[#12372A] block leading-none">05</span>
                <span class="font-sans text-xs text-[#414844] uppercase tracking-wider block mt-1">Specialized Divisions</span>
              </div>
              <div>
                <span class="font-serif text-3xl font-bold text-[#12372A] block leading-none">100%</span>
                <span class="font-sans text-xs text-[#414844] uppercase tracking-wider block mt-1">Vetted Custody</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Key Pillars Bar -->
      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4 p-4 rounded-xl bg-[#F6F3F2] shadow-sm border border-[#DDE7E1]">
        <div class="flex items-center gap-3 px-3 py-2">
          <span class="material-symbols-outlined text-[#C9A24A] text-2xl">account_balance</span>
          <div>
            <span class="font-sans text-xs uppercase tracking-widest text-[#12372A] block font-semibold">Unified</span>
            <span class="font-sans text-xs text-[#414844]">Stewardship Model</span>
          </div>
        </div>
        <div class="flex items-center gap-3 px-3 py-2">
          <span class="material-symbols-outlined text-[#C9A24A] text-2xl">verified_user</span>
          <div>
            <span class="font-sans text-xs uppercase tracking-widest text-[#12372A] block font-semibold">Ethical</span>
            <span class="font-sans text-xs text-[#414844]">Operational Rigor</span>
          </div>
        </div>
        <div class="flex items-center gap-3 px-3 py-2">
          <span class="material-symbols-outlined text-[#C9A24A] text-2xl">hub</span>
          <div>
            <span class="font-sans text-xs uppercase tracking-widest text-[#12372A] block font-semibold">Five Core</span>
            <span class="font-sans text-xs text-[#414844]">Service Verticals</span>
          </div>
        </div>
        <div class="flex items-center gap-3 px-3 py-2">
          <span class="material-symbols-outlined text-[#C9A24A] text-2xl">public</span>
          <div>
            <span class="font-sans text-xs uppercase tracking-widest text-[#12372A] block font-semibold">Nationwide</span>
            <span class="font-sans text-xs text-[#414844]">Reach</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: The Aisance Story -->
  <section class="w-full bg-[#F6F3F2] py-20 lg:py-28 border-y border-[#DDE7E1]">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 reveal-on-scroll">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 flex flex-col gap-6">
          <div class="inline-flex items-center gap-2 text-[#C9A24A]">
            <span class="material-symbols-outlined text-base">history_edu</span>
            <span class="font-sans text-xs uppercase tracking-widest font-bold">Our Provenance &amp; Raison D'être</span>
          </div>

          <h2 class="font-serif text-3xl sm:text-4xl text-[#12372A] font-bold tracking-tight">
            A Cohesive Parent Holding for Nigeria's Everyday Needs
          </h2>

          <div class="space-y-4 text-[#1C1B1B] font-sans text-base leading-relaxed">
            <p>
              Headquartered in Edo State and serving families and corporations across metropolitan Nigeria, Aisance Group was founded as a resolute answer to everyday domestic and operational friction. Everyday life is all too often burdened by fragmented service vendors, erratic quality benchmarks, unpredictable pricing, and an absence of genuine accountability.
            </p>
            <p class="text-[#414844]">
              Aisance Group was founded as a resolute answer to this fragmentation. Rather than juggling disconnected artisans, casual cleaners, and unbonded couriers, our patrons rely on a unified institutional home. We established an interlocking ecosystem where five vital daily disciplines operate under one uncompromising standard of certified excellence.
            </p>
            <p class="text-[#414844]">
              Every formula we brew, every fabric we restore, every pantry we stock, and every confidential document our dispatchers carry is backstopped by the corporate balance sheet, vetted personnel, and sovereign reputation of Aisance Group.
            </p>
          </div>

          <div class="p-6 rounded-xl bg-[#FFFFFF] shadow-sm mt-2 border-l-4 border-[#C9A24A] border-y border-r border-[#DDE7E1]">
            <p class="font-serif text-lg italic text-[#12372A] leading-snug">
              "We do not believe convenience should require compromising on institutional standards. Quality is not an afterthought—it is our charter."
            </p>
          </div>
        </div>

        <div class="lg:col-span-5 flex flex-col gap-6">
          <div class="rounded-2xl overflow-hidden shadow-xl border border-[#DDE7E1] bg-[#FCF9F8]">
            <img
              src="/images/toiletries.png"
              alt="Artisanal formulations by Aisance Group"
              class="w-full h-80 object-cover"
              loading="lazy"
              width="600"
              height="320"
            />
            <div class="p-6 bg-[#FCF9F8]">
              <span class="font-sans text-xs uppercase tracking-widest text-[#C9A24A] font-bold block mb-1">Apothecary Lab</span>
              <h3 class="font-serif text-xl font-semibold text-[#12372A]">Botanical Care Standards</h3>
              <p class="font-sans text-xs text-[#414844] mt-2 leading-relaxed">
                Formulating pure cold-process soaps and hypoallergenic room sprays with unbleached natural oils.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Core Values -->
  <section class="w-full bg-[#FCF9F8] py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="max-w-3xl mb-16 reveal-on-scroll">
        <span class="font-sans text-xs uppercase tracking-widest text-[#C9A24A] font-bold block mb-2">Our Principles</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#12372A] font-normal">
          The Foundations of Our Stewardship
        </h2>
        <p class="font-sans text-base text-[#414844] mt-4 leading-relaxed">
          Four tenets guide our operational standards across every subsidiary and division.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {values.map((v, idx) => (
          <div class={`p-8 rounded-xl bg-[#FFFFFF] shadow-sm card-hover-lift flex flex-col justify-between h-full border border-[#DDE7E1] reveal-on-scroll stagger-${(idx % 4) + 1}`}>
            <div>
              <div class="w-12 h-12 rounded-lg bg-[#F0EDED] flex items-center justify-center text-[#C9A24A] mb-6 shadow-sm">
                <span class="material-symbols-outlined text-2xl">{v.icon}</span>
              </div>
              <span class="font-sans text-xs text-[#C9A24A] font-bold uppercase tracking-widest mb-1 block">{v.num}</span>
              <h3 class="font-serif text-2xl text-[#12372A] mb-3 font-semibold">{v.title}</h3>
              <p class="font-sans text-sm text-[#414844] leading-relaxed">
                {v.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: The 5 Divisions Showcase -->
  <section class="w-full bg-[#FFFFFF] py-20 lg:py-28 border-t border-[#DDE7E1]">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
        <div>
          <span class="font-sans text-xs uppercase tracking-widest text-[#C9A24A] font-bold block mb-2">Five Disciplines</span>
          <h2 class="font-serif text-3xl sm:text-4xl text-[#12372A] font-normal">Our Interlocking Verticals</h2>
        </div>
        <Button href="/services" variant="primary" size="md">
          Explore All Services
        </Button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6">
        {divisions.map((d) => (
          <a
            href={d.href}
            class="p-6 rounded-xl bg-[#FCF9F8] border border-[#DDE7E1] hover:border-[#C9A24A] hover:shadow-md transition-all flex flex-col justify-between group"
          >
            <div>
              <span class="font-sans text-xs text-[#C9A24A] font-bold block mb-2">{d.num}</span>
              <h3 class="font-serif text-lg font-semibold text-[#12372A] group-hover:text-[#C9A24A] transition-colors mb-2">
                {d.name}
              </h3>
              <p class="font-sans text-xs text-[#414844] leading-relaxed">
                {d.desc}
              </p>
            </div>
            <div class="pt-4 mt-6 border-t border-[#DDE7E1]/50 flex items-center justify-between text-[#12372A] group-hover:text-[#C9A24A]">
              <span class="font-sans text-xs uppercase font-semibold tracking-wider">Details</span>
              <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="w-full bg-[#12372A] py-20 text-[#FCF9F8] text-center">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-white">
        Experience the Ease of Unified Standards
      </h2>
      <p class="font-sans text-base sm:text-lg text-[#A8CFBD] mt-4 max-w-2xl mx-auto leading-relaxed">
        Speak with our senior client desk to arrange regular housekeeping, bulk pantry orders, garment pickup, or express dispatch.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 mt-8">
        <Button href="/request-service" variant="gold" size="lg">
          Request a Service
        </Button>
        <Button href="/contact" variant="secondary" size="lg" className="border-[#FCF9F8] text-[#FCF9F8] hover:bg-[#FCF9F8]/10">
          Contact Concierge
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
