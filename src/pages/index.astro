---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Button from '../components/Button.astro';

const seoTitle = 'Aisance Group | Quality Services. One Trusted Name.';
const seoDescription = 'Aisance Group delivers dependable solutions across toiletries production, home & commercial cleaning, dry cleaning, food supply, and errand logistics in Nigeria.';

const divisions = [
  {
    number: '01',
    title: 'Toiletries Production',
    category: 'Organic Formulation',
    description: 'Handcrafted, organic botanical soaps, cleansers, and personal care formulations engineered for pure vitality and skin nourishment.',
    tag: 'Handcrafted Small Batch',
    href: '/services/toiletries-production',
    imageSrc: '/images/toiletries.png',
  },
  {
    number: '02',
    title: 'Home & Commercial Cleaning',
    category: 'Sanitation & Upkeep',
    description: 'Meticulous deep-cleaning and ongoing housekeeping for high-end residences, corporate suites, executive clinics, and event venues.',
    tag: 'Hospital-Grade Standards',
    href: '/services/cleaning',
    imageSrc: '/images/cleaning.png',
  },
  {
    number: '03',
    title: 'Dry Cleaning Services',
    category: 'Garment Restoration',
    description: 'Master garment care, fabric restoration, bespoke pressing, and seasonal wardrobe upkeep handling silk, wool, and heirloom wear.',
    tag: 'Delicate Fabric Care',
    href: '/services/dry-cleaning',
    imageSrc: '/images/dry-cleaning.png',
  },
  {
    number: '04',
    title: 'Food Thrift',
    category: 'Provisions & Bulk Pantry',
    description: 'Convenient access to premium everyday food supplies, wholesale grain curation, and curated pantry baskets tailored for modern households.',
    tag: 'Wholesale Savings',
    href: '/services/food-thrift',
    imageSrc: '/images/food-thrift.png',
  },
  {
    number: '05',
    title: 'Errand & Logistics',
    category: 'Fast & Discreet',
    description: 'Discreet, dependable personal concierge errands, express parcel handling, and corporate fulfillment designed to save hours of valuable executive time.',
    tag: 'Point-To-Point Tracking',
    href: '/services/errand-logistics',
    imageSrc: '/images/logistics.png',
  },
];

const pillars = [
  {
    icon: 'diamond',
    title: 'Quality',
    badge: 'Verified Standard',
    description: 'Rigorous attention to detail and uncompromising standards applied across every singular product formulation and field engagement.',
  },
  {
    icon: 'published_with_changes',
    title: 'Reliability',
    badge: 'Unwavering Consistency',
    description: 'Consistent, punctual, and accountable service delivery you can depend upon with complete peace of mind, every single day.',
  },
  {
    icon: 'hub',
    title: 'Convenience',
    badge: 'Single Point of Contact',
    description: 'One consolidated partner managing personal, home, and commercial requirements without fragmented multiple vendor headaches.',
  },
  {
    icon: 'badge',
    title: 'Professional Service',
    badge: 'Vetted Specialists',
    description: 'Trained, thoroughly vetted, and courteous specialists committed to discreet excellence and executive workplace protocols.',
  },
];

const steps = [
  {
    num: '01',
    title: 'Tell Us What You Need',
    desc: 'Share your specific requirement through our simple online portal or directly via our dedicated telephone concierge desk.',
    icon: 'touch_app',
    tag: 'Digital or Phone Intake',
  },
  {
    num: '02',
    title: 'We Handle It',
    desc: 'Our dedicated division leads coordinate execution with institutional precision, rigorous safety checks, and absolute quality control.',
    icon: 'task_alt',
    tag: 'Supervised Deployment',
  },
  {
    num: '03',
    title: 'Enjoy Reliable Service',
    desc: 'Experience effortless, flawless delivery tailored exactly to your schedule, freeing your time for what matters most.',
    icon: 'sentiment_satisfied',
    tag: 'Peace of Mind',
  },
];
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <!-- HERO SECTION -->
  <section class="relative w-full overflow-hidden bg-[#FCF9F8] py-12 lg:py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-7 flex flex-col items-start z-10">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-[#EAE7E7] text-[#12372A] mb-6 shadow-sm border border-[#DDE7E1]">
            <span class="material-symbols-outlined text-[16px] text-[#C9A24A]">verified</span>
            <span class="font-sans text-xs uppercase tracking-widest text-[#12372A] font-semibold">Premier Nigerian Enterprise &bull; Edo State &amp; Nationwide</span>
          </div>

          <h1 class="font-serif text-4xl sm:text-5xl lg:text-[62px] lg:leading-[68px] text-[#12372A] tracking-tight font-normal">
            Quality Services.<br />
            <span class="italic font-normal text-[#C9A24A]">One Trusted Name.</span>
          </h1>

          <p class="font-sans text-base sm:text-lg text-[#414844] mt-6 max-w-xl leading-relaxed">
            Aisance Group delivers reliable solutions across toiletries production, cleaning, dry cleaning, food supply, and logistics—elevating everyday standards with discreet elegance.
          </p>

          <div class="flex flex-wrap items-center gap-4 mt-8 w-full sm:w-auto">
            <Button href="/services" variant="primary" size="lg">
              Explore Our Services
            </Button>
            <Button href="/request-service" variant="secondary" size="lg">
              Request a Service
            </Button>
          </div>

          <!-- Credential Mini Badges -->
          <div class="grid grid-cols-3 gap-6 pt-10 mt-10 w-full bg-[#FFFFFF] rounded-xl p-5 shadow-sm border border-[#DDE7E1]/80">
            <div>
              <div class="font-serif text-2xl sm:text-3xl text-[#12372A] font-bold">5</div>
              <div class="font-sans text-xs text-[#414844] uppercase tracking-wider mt-1 font-medium">Core Divisions</div>
            </div>
            <div>
              <div class="font-serif text-2xl sm:text-3xl text-[#12372A] font-bold">100%</div>
              <div class="font-sans text-xs text-[#414844] uppercase tracking-wider mt-1 font-medium">Vetted Execution</div>
            </div>
            <div>
              <div class="font-serif text-2xl sm:text-3xl text-[#12372A] font-bold">24/7</div>
              <div class="font-sans text-xs text-[#414844] uppercase tracking-wider mt-1 font-medium">Dedicated Support</div>
            </div>
          </div>
        </div>

        <!-- Hero Media Showcase -->
        <div class="lg:col-span-5 relative">
          <div class="relative w-full rounded-2xl overflow-hidden shadow-2xl bg-[#EAE7E7] border border-[#DDE7E1]">
            <img
              src="/images/cleaning.png"
              alt="Aisance Group luxury modern architectural interior and bespoke standard"
              class="w-full h-[460px] lg:h-[540px] object-cover"
              width="600"
              height="700"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#12372A]/80 via-transparent to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-[#FCF9F8]/95 backdrop-blur-md shadow-lg flex items-center justify-between border border-[#DDE7E1]">
              <div>
                <span class="font-sans text-[11px] text-[#C9A24A] uppercase tracking-widest font-bold block">Executive Quality</span>
                <span class="font-serif text-lg sm:text-xl text-[#12372A] font-semibold">Bespoke Living Standards</span>
              </div>
              <div class="w-10 h-10 rounded-full bg-[#12372A] flex items-center justify-center text-[#FCF9F8] shadow-sm">
                <span class="material-symbols-outlined text-[20px] text-[#FFDF9E]">verified_user</span>
              </div>
            </div>
          </div>

          <!-- Ambient Floating Tag -->
          <div class="absolute -top-4 -right-4 bg-[#12372A] text-[#FCF9F8] py-2.5 px-4 rounded-lg shadow-xl hidden sm:flex items-center gap-2 border border-[#C9A24A]/40">
            <span class="material-symbols-outlined text-[#FFDF9E] text-[18px]">workspace_premium</span>
            <span class="font-sans text-xs uppercase tracking-wider font-semibold">Multi-Sector Stewardship</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust Ticker / Credential Ribbon -->
    <div class="mt-14 w-full bg-[#F6F3F2] py-4 shadow-sm border-y border-[#DDE7E1]">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-wrap items-center justify-between gap-6 text-[#414844]">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[#C9A24A] text-[18px]">verified</span>
          <span class="font-sans text-xs font-semibold tracking-wider uppercase text-[#12372A]">Residential &amp; Corporate Excellence</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[#C9A24A] text-[18px]">location_on</span>
          <span class="font-sans text-xs font-semibold tracking-wider uppercase text-[#12372A]">Edo State &bull; Nationwide Reach</span>
        </div>
        <div class="hidden lg:flex items-center gap-2">
          <span class="material-symbols-outlined text-[#C9A24A] text-[18px]">support_agent</span>
          <span class="font-sans text-xs font-semibold tracking-wider uppercase text-[#12372A]">Dedicated Client Managers</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[#C9A24A] text-[18px]">schedule</span>
          <span class="font-sans text-xs font-semibold tracking-wider uppercase text-[#12372A]">On-Time Guaranteed Fulfillment</span>
        </div>
      </div>
    </div>
  </section>

  <!-- STATEMENT OF PURPOSE / SHORT INTRO -->
  <section class="w-full bg-[#FCF9F8] py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-6 text-center flex flex-col items-center reveal-on-scroll">
      <div class="w-12 h-1 rounded-full bg-[#C9A24A] mb-6"></div>
      <span class="font-sans text-xs uppercase tracking-widest text-[#C9A24A] font-bold mb-3">Our Core Philosophy</span>
      <h2 class="font-serif text-3xl sm:text-4xl text-[#12372A] tracking-tight font-normal leading-snug">
        Built on the principles of integrity, excellence, and effortless living.
      </h2>
      <p class="font-sans text-base sm:text-lg text-[#414844] mt-6 leading-relaxed max-w-3xl">
        Aisance Group operates as a distinguished parent brand delivering everyday solutions with uncompromising standards across Edo State and nationwide Nigeria. We harmonize multiple domestic and institutional verticals into a unified standard of dependability.
      </p>
    </div>
  </section>

  <!-- FIVE SPECIALIZED DIVISIONS -->
  <section class="w-full bg-[#FFFFFF] py-20 lg:py-28 shadow-sm border-y border-[#DDE7E1]" id="services">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 reveal-on-scroll">
        <div>
          <span class="font-sans text-xs uppercase tracking-widest text-[#C9A24A] font-bold block mb-2">Our Portfolio</span>
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#12372A] font-normal">
            Everything You Need.<br />
            <span class="italic text-[#C9A24A]">Under One Name.</span>
          </h2>
        </div>
        <p class="font-sans text-sm sm:text-base text-[#414844] max-w-md leading-relaxed">
          A seamless ecosystem of curated lifestyle and corporate capabilities, crafted to resolve domestic complexity with understated mastery.
        </p>
      </div>

      <!-- Divisions Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {divisions.map((div, index) => (
          <div class={`reveal-on-scroll stagger-${(index % 3) + 1} ${index === 4 ? 'md:col-span-2 lg:col-span-2' : ''}`}>
            <ServiceCard
              number={div.number}
              title={div.title}
              category={div.category}
              description={div.description}
              tag={div.tag}
              href={div.href}
              imageSrc={div.imageSrc}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY AISANCE GROUP (THE 4 PILLARS) -->
  <section class="w-full bg-[#FCF9F8] py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="max-w-3xl mb-16 reveal-on-scroll">
        <span class="font-sans text-xs uppercase tracking-widest text-[#C9A24A] font-bold block mb-2">Our Foundation</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#12372A] font-normal">
          Why Discerning Clients<br />
          <span class="italic text-[#C9A24A]">Trust Aisance Group</span>
        </h2>
        <p class="font-sans text-base text-[#414844] mt-4 leading-relaxed">
          Through deliberate attention to standard, discipline, and execution, we cultivate enduring relationships with Nigeria's families and corporate institutions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {pillars.map((pillar, idx) => (
          <div class={`p-8 rounded-xl bg-[#FFFFFF] shadow-sm card-hover-lift flex flex-col justify-between h-full border border-[#DDE7E1] reveal-on-scroll stagger-${(idx % 4) + 1}`}>
            <div>
              <div class="w-12 h-12 rounded-lg bg-[#F0EDED] flex items-center justify-center text-[#C9A24A] mb-6 shadow-sm">
                <span class="material-symbols-outlined text-2xl">{pillar.icon}</span>
              </div>
              <h3 class="font-serif text-2xl text-[#12372A] mb-3 font-semibold">{pillar.title}</h3>
              <p class="font-sans text-sm text-[#414844] leading-relaxed">
                {pillar.description}
              </p>
            </div>
            <div class="pt-6 mt-6 border-t border-[#DDE7E1]/50">
              <span class="font-sans text-xs text-[#C9A24A] font-bold tracking-widest uppercase">{pillar.badge}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS (3 STEPS) -->
  <section class="w-full bg-[#F6F3F2] py-20 lg:py-28 border-y border-[#DDE7E1]">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
        <span class="font-sans text-xs uppercase tracking-widest text-[#C9A24A] font-bold block mb-2">Simplicity by Design</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#12372A] font-normal">How It Works</h2>
        <p class="font-sans text-sm sm:text-base text-[#414844] mt-3">
          We strip friction from your routine through an effortless, orchestrated tripartite process.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        {steps.map((step, idx) => (
          <div class={`p-8 rounded-xl bg-[#FCF9F8] shadow-sm card-hover-lift relative z-10 flex flex-col border border-[#DDE7E1] reveal-on-scroll stagger-${(idx % 3) + 1}`}>
            <div class="font-serif text-4xl text-[#C9A24A] mb-4 font-bold">{step.num}</div>
            <h3 class="font-serif text-2xl text-[#12372A] mb-3 font-semibold">{step.title}</h3>
            <p class="font-sans text-sm text-[#414844] leading-relaxed flex-grow">
              {step.desc}
            </p>
            <div class="mt-8 pt-4 border-t border-[#DDE7E1]/60 flex items-center gap-2 text-[#12372A] font-sans text-xs tracking-wider uppercase font-semibold">
              <span class="material-symbols-outlined text-[18px] text-[#C9A24A]">{step.icon}</span>
              <span>{step.tag}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- IMPACTFUL CTA BANNER -->
  <section class="w-full bg-[#12372A] py-20 lg:py-28 relative overflow-hidden text-[#FCF9F8]">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10 reveal-on-scroll">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-[#FCF9F8]/10 text-[#FFDF9E] mb-4 border border-[#C9A24A]/30">
            <span class="material-symbols-outlined text-[16px]">bolt</span>
            <span class="font-sans text-xs uppercase tracking-widest font-semibold">Immediate Engagement</span>
          </div>

          <h2 class="font-serif text-3xl sm:text-4xl lg:text-[50px] lg:leading-[58px] text-[#FCF9F8] font-normal">
            Ready to Experience the Aisance Difference?
          </h2>

          <p class="font-sans text-base sm:text-lg text-[#A8CFBD] mt-6 max-w-2xl leading-relaxed">
            Connect with our concierge team today to schedule cleaning, reserve pantry allocations, order dry cleaning pickup, or fulfill bespoke errand tasks.
          </p>

          <div class="flex flex-wrap items-center gap-6 mt-10">
            <a
              href="tel:08141937193"
              class="inline-flex items-center gap-3 bg-[#C9A24A] text-[#12372A] px-8 py-4 rounded-lg font-sans text-sm uppercase tracking-wider hover:bg-[#ebc165] transition-all shadow-lg font-bold"
            >
              <span class="material-symbols-outlined text-xl">call</span>
              <span>Call 08141937193</span>
            </a>

            <a
              href="mailto:hello.aisancegroup@gmail.com"
              class="inline-flex items-center gap-2 text-[#FCF9F8] hover:text-[#FFDF9E] transition-colors font-sans text-sm uppercase tracking-wider font-semibold"
            >
              <span class="material-symbols-outlined text-lg">mail</span>
              <span>hello.aisancegroup@gmail.com</span>
            </a>
          </div>
        </div>

        <!-- Quick Request Card -->
        <div class="lg:col-span-4 bg-[#FFFFFF]/10 backdrop-blur-md p-8 rounded-2xl shadow-xl border border-[#C9A24A]/30">
          <h3 class="font-serif text-2xl text-[#FCF9F8] mb-2 font-medium">Quick Request</h3>
          <p class="font-sans text-xs text-[#A8CFBD] mb-6">Select your primary division to get started immediately.</p>
          
          <form action="/request-service" method="GET" class="flex flex-col gap-4">
            <div>
              <label class="font-sans text-xs uppercase tracking-wider text-[#FCF9F8] block mb-1 font-semibold">Service Division</label>
              <select
                name="service"
                class="w-full bg-[#FCF9F8] text-[#1C1B1B] px-4 py-2.5 rounded-lg font-sans text-sm outline-none border border-[#DDE7E1]"
              >
                <option value="cleaning">Home &amp; Commercial Cleaning</option>
                <option value="dry-cleaning">Dry Cleaning Services</option>
                <option value="toiletries">Toiletries Production</option>
                <option value="food-thrift">Food Thrift &amp; Provisions</option>
                <option value="errand-logistics">Errand &amp; Logistics</option>
              </select>
            </div>

            <Button type="submit" variant="gold" size="lg" className="w-full mt-2 font-bold">
              Proceed to Request
            </Button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
