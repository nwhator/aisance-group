---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';

const seoTitle = 'Contact Aisance Group | Get in Touch';
const seoDescription = 'Contact Aisance Group central concierge by phone at 08141937193 or email hello.aisancegroup@gmail.com for inquiries across all five divisions.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact' },
];
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <section class="w-full max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-12">
    <div class="mb-6">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Header Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end pb-8">
      <div class="lg:col-span-8 flex flex-col gap-4">
        <div class="inline-flex items-center gap-2 self-start px-3 py-1 bg-[#EAE7E7] rounded-lg text-[#12372A] border border-[#DDE7E1]">
          <span class="material-symbols-outlined text-sm text-[#C9A24A]">mail</span>
          <span class="font-sans text-xs tracking-widest uppercase font-semibold">Institutional Contact Desk</span>
        </div>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-[#12372A] tracking-tight font-normal">
          Get in Touch<span class="text-[#C9A24A]">.</span>
        </h1>
        <p class="font-sans text-base sm:text-lg text-[#414844] max-w-2xl leading-relaxed">
          Connect directly with our central desk. Whether booking a single service, exploring corporate retainers, or seeking bespoke solutions, our team is at your disposal.
        </p>
      </div>

      <div class="lg:col-span-4 flex flex-col justify-end">
        <div class="bg-[#FFFFFF] p-5 rounded-2xl flex items-center justify-between shadow-sm border border-[#DDE7E1]">
          <div class="flex items-center gap-3">
            <span class="w-3 h-3 rounded-full bg-[#C9A24A]"></span>
            <div class="flex flex-col">
              <span class="font-sans text-xs uppercase text-[#414844]">Response Window</span>
              <span class="font-sans text-sm font-semibold text-[#12372A]">Within 30 Minutes</span>
            </div>
          </div>
          <span class="font-sans text-xs uppercase px-2.5 py-1 bg-[#12372A] text-white rounded font-medium">Standard Hours</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Dual Column Contact Section -->
  <section class="w-full max-w-7xl mx-auto px-6 lg:px-12 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left Column: Form -->
      <div class="lg:col-span-7">
        <ContactForm />
      </div>

      <!-- Right Column: Direct Channels Card -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="bg-[#12372A] text-[#FCF9F8] p-8 rounded-2xl shadow-lg relative overflow-hidden flex flex-col gap-6 border border-[#C9A24A]/40">
          <div class="flex items-center justify-between">
            <span class="font-sans text-xs uppercase tracking-widest text-[#FFDF9E] font-bold">Direct Channels</span>
            <span class="material-symbols-outlined text-[#FFDF9E] text-2xl">support_agent</span>
          </div>

          <div>
            <h2 class="font-serif text-2xl text-white font-normal">Executive Inquiries &amp; Dispatch</h2>
            <p class="font-sans text-sm text-[#A8CFBD] mt-2 leading-relaxed">
              For urgent bookings, same-day errands, or direct manager consultation, use our direct telephone line or email.
            </p>
          </div>

          <div class="flex flex-col gap-4 pt-2">
            <!-- Telephone -->
            <a
              href="tel:08141937193"
              class="bg-[#1a4a39] hover:bg-[#205b46] text-white p-4 rounded-xl flex items-center gap-4 transition-colors border border-[#C9A24A]/30"
            >
              <div class="w-10 h-10 rounded-lg bg-[#12372A] flex items-center justify-center text-[#FFDF9E] shrink-0">
                <span class="material-symbols-outlined text-xl">call</span>
              </div>
              <div class="flex flex-col">
                <span class="font-sans text-[11px] uppercase tracking-wider text-[#FFDF9E]">Direct Telephone</span>
                <span class="font-sans text-base font-bold">0814 193 7193</span>
              </div>
            </a>

            <!-- Email -->
            <a
              href="mailto:hello.aisancegroup@gmail.com"
              class="bg-[#1a4a39] hover:bg-[#205b46] text-white p-4 rounded-xl flex items-center gap-4 transition-colors border border-[#C9A24A]/30"
            >
              <div class="w-10 h-10 rounded-lg bg-[#12372A] flex items-center justify-center text-[#FFDF9E] shrink-0">
                <span class="material-symbols-outlined text-xl">mail</span>
              </div>
              <div class="flex flex-col">
                <span class="font-sans text-[11px] uppercase tracking-wider text-[#FFDF9E]">Electronic Mail</span>
                <span class="font-sans text-sm font-semibold break-all">hello.aisancegroup@gmail.com</span>
              </div>
            </a>

            <!-- Location -->
            <div class="bg-[#1a4a39]/60 text-white p-4 rounded-xl flex items-center gap-4 border border-[#C9A24A]/20">
              <div class="w-10 h-10 rounded-lg bg-[#12372A] flex items-center justify-center text-[#FFDF9E] shrink-0">
                <span class="material-symbols-outlined text-xl">location_on</span>
              </div>
              <div class="flex flex-col">
                <span class="font-sans text-[11px] uppercase tracking-wider text-[#FFDF9E]">Operational Coverage</span>
                <span class="font-sans text-sm">Lagos &amp; across Nigeria</span>
              </div>
            </div>
          </div>

          <div class="pt-4 bg-[#0e2c21] -mx-8 -mb-8 p-6 flex flex-col gap-1 border-t border-[#C9A24A]/20">
            <span class="font-sans text-xs uppercase tracking-widest text-[#FFDF9E] font-semibold">Active Desk Hours</span>
            <span class="font-sans text-xs text-[#A8CFBD]">Monday – Saturday: 7:30 AM – 7:30 PM WAT</span>
            <span class="font-sans text-xs text-[#A8CFBD]/80">Sunday: On-Call Urgent Logistics Only</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
