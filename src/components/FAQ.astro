---
export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  includeSchema?: boolean;
  className?: string;
}

const { items, includeSchema = true, className = '' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<div class={`flex flex-col gap-4 w-full ${className}`}>
  {items.map((item, idx) => (
    <details
      class="group bg-[#FCF9F8] rounded-xl border border-[#DDE7E1] p-5 lg:p-6 transition-all duration-300 open:shadow-sm open:border-[#C9A24A]/60"
    >
      <summary class="flex items-center justify-between cursor-pointer list-none select-none text-left focus-visible:outline-none">
        <h3 class="font-serif text-lg sm:text-xl text-[#12372A] font-medium pr-4 group-open:text-[#C9A24A] transition-colors">
          {item.question}
        </h3>
        <span class="w-8 h-8 rounded-full bg-[#F0EDED] group-open:bg-[#12372A] group-open:text-[#FCF9F8] text-[#12372A] flex items-center justify-center flex-shrink-0 transition-colors">
          <span class="material-symbols-outlined text-lg transition-transform duration-300 group-open:rotate-180">
            keyboard_arrow_down
          </span>
        </span>
      </summary>
      <div class="mt-4 pt-4 border-t border-[#DDE7E1]/50 text-sm text-[#414844] font-sans leading-relaxed">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>

{includeSchema && items.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<style>
  /* Remove native disclosure triangle */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
