---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`bg-[#FCF9F8] rounded-2xl p-6 sm:p-10 shadow-sm border border-[#DDE7E1] ${className}`}>
  <div class="mb-8 pb-6 border-b border-[#DDE7E1]">
    <span class="font-sans text-xs uppercase tracking-widest text-[#C9A24A] font-bold">Inquiries &amp; Executive Liaison</span>
    <h2 class="font-serif text-2xl sm:text-3xl text-[#12372A] mt-1 font-semibold">Send a Direct Message</h2>
    <p class="font-sans text-sm text-[#414844] mt-2">
      Our client managers respond to written inquiries within business hours.
    </p>
  </div>

  <form id="contact-inquiry-form" class="flex flex-col gap-6" novalidate>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div class="sm:col-span-2 flex flex-col gap-1.5">
        <label class="font-sans text-xs uppercase tracking-wider text-[#414844] font-semibold" for="contact-name">
          Your Name <span class="text-red-700" aria-hidden="true">*</span>
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          placeholder="Chief Adebayo Adeleke"
          class="w-full bg-[#F6F3F2] px-4 py-3 rounded-lg text-[#1C1B1B] font-sans text-sm border border-[#DDE7E1] focus:bg-[#FFFFFF] focus:border-[#C9A24A] focus:outline-none transition-all"
        />
        <span class="hidden text-xs text-red-700 mt-1 font-sans" id="err-contact-name">Please enter your name.</span>
      </div>

      <div class="flex flex-col gap-1.5">
        <label class="font-sans text-xs uppercase tracking-wider text-[#414844] font-semibold" for="contact-email">
          Email Address <span class="text-red-700" aria-hidden="true">*</span>
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          placeholder="adebayo@example.com"
          class="w-full bg-[#F6F3F2] px-4 py-3 rounded-lg text-[#1C1B1B] font-sans text-sm border border-[#DDE7E1] focus:bg-[#FFFFFF] focus:border-[#C9A24A] focus:outline-none transition-all"
        />
        <span class="hidden text-xs text-red-700 mt-1 font-sans" id="err-contact-email">Please enter a valid email address.</span>
      </div>

      <div class="flex flex-col gap-1.5">
        <label class="font-sans text-xs uppercase tracking-wider text-[#414844] font-semibold" for="contact-phone">
          Phone Number <span class="text-red-700" aria-hidden="true">*</span>
        </label>
        <input
          id="contact-phone"
          name="phone"
          type="tel"
          required
          placeholder="0814 193 7193"
          class="w-full bg-[#F6F3F2] px-4 py-3 rounded-lg text-[#1C1B1B] font-sans text-sm border border-[#DDE7E1] focus:bg-[#FFFFFF] focus:border-[#C9A24A] focus:outline-none transition-all"
        />
        <span class="hidden text-xs text-red-700 mt-1 font-sans" id="err-contact-phone">Please enter your phone number.</span>
      </div>

      <div class="sm:col-span-2 flex flex-col gap-1.5">
        <label class="font-sans text-xs uppercase tracking-wider text-[#414844] font-semibold" for="contact-subject">
          Subject / Division of Interest
        </label>
        <select
          id="contact-subject"
          name="subject"
          class="w-full bg-[#F6F3F2] px-4 py-3 rounded-lg text-[#1C1B1B] font-sans text-sm border border-[#DDE7E1] focus:bg-[#FFFFFF] focus:border-[#C9A24A] focus:outline-none transition-all"
        >
          <option value="General Inquiry">General Corporate Inquiry</option>
          <option value="Toiletries Production">Toiletries Production Division</option>
          <option value="Cleaning Services">Home &amp; Commercial Cleaning</option>
          <option value="Dry Cleaning Services">Dry Cleaning Services</option>
          <option value="Food Thrift">Food Thrift &amp; Provisions</option>
          <option value="Errand & Logistics">Errand &amp; Logistics</option>
          <option value="Corporate Retainer">Corporate Multi-Service Retainer</option>
        </select>
      </div>

      <div class="sm:col-span-2 flex flex-col gap-1.5">
        <label class="font-sans text-xs uppercase tracking-wider text-[#414844] font-semibold" for="contact-message">
          Message <span class="text-red-700" aria-hidden="true">*</span>
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="4"
          required
          placeholder="How may our holding divisions assist you?"
          class="w-full bg-[#F6F3F2] px-4 py-3 rounded-lg text-[#1C1B1B] font-sans text-sm border border-[#DDE7E1] focus:bg-[#FFFFFF] focus:border-[#C9A24A] focus:outline-none transition-all"
        ></textarea>
        <span class="hidden text-xs text-red-700 mt-1 font-sans" id="err-contact-message">Please enter your message.</span>
      </div>
    </div>

    <div id="contact-success-msg" class="hidden p-4 rounded-lg bg-[#DDE7E1]/60 border border-[#12372A]/20 text-[#12372A] font-sans text-sm">
      <div class="flex items-center gap-2 font-semibold">
        <span class="material-symbols-outlined text-[#C9A24A]">check_circle</span>
        <span>Thank you for your message.</span>
      </div>
      <p class="mt-1 text-xs text-[#414844]">Our client concierge desk will review your inquiry and reach out promptly.</p>
    </div>

    <button
      type="submit"
      id="contact-submit-btn"
      class="w-full bg-[#12372A] text-[#F7F5EF] font-sans text-xs uppercase tracking-widest py-4 px-6 rounded-lg hover:bg-[#1a4a39] border border-[#C9A24A]/40 transition-all flex items-center justify-center gap-3 shadow-md font-bold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C9A24A] active:scale-[0.99] cursor-pointer"
    >
      <span>Send Message</span>
      <span class="material-symbols-outlined text-[#FFDF9E] text-lg">send</span>
    </button>
  </form>
</div>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-inquiry-form') as HTMLFormElement | null;
    const successMsg = document.getElementById('contact-success-msg');
    const submitBtn = document.getElementById('contact-submit-btn');
    if (!form || !successMsg || !submitBtn) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let hasError = false;

      const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
      const phoneInput = document.getElementById('contact-phone') as HTMLInputElement | null;
      const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

      const errName = document.getElementById('err-contact-name');
      const errEmail = document.getElementById('err-contact-email');
      const errPhone = document.getElementById('err-contact-phone');
      const errMessage = document.getElementById('err-contact-message');

      if (!nameInput || nameInput.value.trim().length < 2) {
        errName?.classList.remove('hidden');
        nameInput?.classList.add('border-red-500');
        hasError = true;
      } else {
        errName?.classList.add('hidden');
        nameInput?.classList.remove('border-red-500');
      }

      if (!emailInput || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value.trim())) {
        errEmail?.classList.remove('hidden');
        emailInput?.classList.add('border-red-500');
        hasError = true;
      } else {
        errEmail?.classList.add('hidden');
        emailInput?.classList.remove('border-red-500');
      }

      if (!phoneInput || phoneInput.value.trim().length < 7) {
        errPhone?.classList.remove('hidden');
        phoneInput?.classList.add('border-red-500');
        hasError = true;
      } else {
        errPhone?.classList.add('hidden');
        phoneInput?.classList.remove('border-red-500');
      }

      if (!messageInput || messageInput.value.trim().length < 5) {
        errMessage?.classList.remove('hidden');
        messageInput?.classList.add('border-red-500');
        hasError = true;
      } else {
        errMessage?.classList.add('hidden');
        messageInput?.classList.remove('border-red-500');
      }

      if (!hasError) {
        // Isolate submission logic: can connect to an API endpoint or email service
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.innerHTML = '<span>Transmitting...</span>';
        
        setTimeout(() => {
          form.reset();
          successMsg.classList.remove('hidden');
          submitBtn.removeAttribute('disabled');
          submitBtn.innerHTML = '<span>Message Sent</span><span class="material-symbols-outlined text-[#FFDF9E] text-lg">check</span>';
        }, 600);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupContactForm);
  } else {
    setupContactForm();
  }
</script>
