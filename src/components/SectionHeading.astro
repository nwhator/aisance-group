---
interface Props {
  eyebrow?: string;
  eyebrowIcon?: string;
  title: string;
  highlightText?: string;
  subtitle?: string;
  align?: 'left' | 'center';
  theme?: 'light' | 'dark';
  className?: string;
}

const {
  eyebrow,
  eyebrowIcon,
  title,
  highlightText,
  subtitle,
  align = 'left',
  theme = 'light',
  className = '',
} = Astro.props;

const isCenter = align === 'center';
const isDark = theme === 'dark';
---

<div class={`flex flex-col ${isCenter ? 'items-center text-center' : 'items-start text-left'} ${className}`}>
  {eyebrow && (
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#DDE7E1]/50 text-[#12372A] mb-4 shadow-sm border border-[#DDE7E1]">
      {eyebrowIcon && <span class="material-symbols-outlined text-[16px] text-[#C9A24A]">{eyebrowIcon}</span>}
      <span class="font-sans text-xs uppercase tracking-widest font-semibold">{eyebrow}</span>
    </div>
  )}

  <h2 class={`font-serif text-3xl sm:text-4xl lg:text-5xl font-normal tracking-tight leading-tight ${isDark ? 'text-[#F7F5EF]' : 'text-[#12372A]'}`}>
    {title}
    {highlightText && (
      <>
        {' '}
        <span class="italic font-normal text-[#C9A24A]">{highlightText}</span>
      </>
    )}
  </h2>

  {subtitle && (
    <p class={`font-sans text-base sm:text-lg mt-4 max-w-2xl leading-relaxed ${isDark ? 'text-[#DDE7E1]' : 'text-[#414844]'}`}>
      {subtitle}
    </p>
  )}
</div>
