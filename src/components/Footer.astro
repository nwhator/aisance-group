---
import Logo from './Logo.astro';

const divisions = [
  { name: 'Toiletries Production', href: '/services/toiletries-production', num: '01' },
  { name: 'Home & Commercial Cleaning', href: '/services/cleaning', num: '02' },
  { name: 'Dry Cleaning Services', href: '/services/dry-cleaning', num: '03' },
  { name: 'Food Thrift', href: '/services/food-thrift', num: '04' },
  { name: 'Errand & Logistics', href: '/services/errand-logistics', num: '05' },
];

const companyLinks = [
  { name: 'About Us', href: '/about' },
  { name: 'Why Aisance', href: '/why-aisance' },
  { name: 'Services Overview', href: '/services' },
  { name: 'FAQ', href: '/faq' },
  { name: 'Request a Service', href: '/request-service' },
  { name: 'Contact', href: '/contact' },
];
---

<footer class="w-full bg-[#12372A] text-[#F7F5EF] border-t border-[#C9A24A]/20">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-16 pb-12">
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-14 border-b border-[#C9A24A]/15">
      <!-- Col 1: Brand & Stewardship Statement -->
      <div class="lg:col-span-4 flex flex-col gap-5">
        <Logo variant="dark" className="h-10 w-auto" />
        
        <p class="font-sans text-sm text-[#A8CFBD] max-w-sm leading-relaxed">
          Quality services across toiletries production, cleaning, dry cleaning, food supply and logistics. One trusted name.
        </p>

        <div class="flex items-center gap-2 pt-1 text-[#FFDF9E]">
          <span class="material-symbols-outlined text-[20px]">spa</span>
          <span class="font-sans text-xs tracking-widest uppercase font-semibold">Excellence &amp; Stewardship</span>
        </div>
      </div>

      <!-- Col 2: Company Navigation -->
      <div class="lg:col-span-2 flex flex-col gap-3">
        <h3 class="font-sans text-xs uppercase tracking-widest text-[#FFDF9E] font-bold mb-2">Company</h3>
        <ul class="flex flex-col gap-2.5">
          {companyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-sm text-[#A8CFBD] hover:text-[#FFFFFF] transition-colors focus-visible:outline-none"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Five Core Divisions -->
      <div class="lg:col-span-3 flex flex-col gap-3">
        <h3 class="font-sans text-xs uppercase tracking-widest text-[#FFDF9E] font-bold mb-2">Five Core Divisions</h3>
        <ul class="flex flex-col gap-2.5">
          {divisions.map((div) => (
            <li>
              <a
                href={div.href}
                class="font-sans text-sm text-[#A8CFBD] hover:text-[#FFFFFF] transition-colors flex items-center gap-2 group focus-visible:outline-none"
              >
                <span class="font-sans text-xs text-[#FFDF9E] font-bold">{div.num}</span>
                <span class="group-hover:translate-x-0.5 transition-transform">{div.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Direct Contact -->
      <div class="lg:col-span-3 flex flex-col gap-3">
        <h3 class="font-sans text-xs uppercase tracking-widest text-[#FFDF9E] font-bold mb-2">Direct Contact</h3>
        
        <div class="flex items-start gap-3 text-[#A8CFBD]">
          <span class="material-symbols-outlined text-[20px] text-[#FFDF9E] mt-0.5">call</span>
          <div class="flex flex-col">
            <span class="font-sans text-[11px] uppercase tracking-wider text-[#A8CFBD]/80">Phone Concierge</span>
            <a href="tel:08141937193" class="font-sans text-sm font-semibold text-[#FFFFFF] hover:text-[#FFDF9E] transition-colors">
              08141937193
            </a>
          </div>
        </div>

        <div class="flex items-start gap-3 text-[#A8CFBD]">
          <span class="material-symbols-outlined text-[20px] text-[#FFDF9E] mt-0.5">mail</span>
          <div class="flex flex-col">
            <span class="font-sans text-[11px] uppercase tracking-wider text-[#A8CFBD]/80">Email Desk</span>
            <a href="mailto:hello.aisancegroup@gmail.com" class="font-sans text-sm text-[#FFFFFF] hover:text-[#FFDF9E] transition-colors break-all">
              hello.aisancegroup@gmail.com
            </a>
          </div>
        </div>

        <div class="flex items-start gap-3 text-[#A8CFBD]">
          <span class="material-symbols-outlined text-[20px] text-[#FFDF9E] mt-0.5">location_on</span>
          <div class="flex flex-col">
            <span class="font-sans text-[11px] uppercase tracking-wider text-[#A8CFBD]/80">Coverage</span>
            <span class="font-sans text-sm text-[#FFFFFF]">Lagos &amp; across Nigeria</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 font-sans text-xs text-[#A8CFBD]/80">
      <p>© {new Date().getFullYear()} Aisance Group. All rights reserved.</p>
      
      <p class="text-center">
        Designed by <a href="https://wa.me/2347048812719" target="_blank" rel="noopener noreferrer" class="text-[#FFDF9E] hover:text-white underline underline-offset-2 transition-colors font-medium">GoBrand.Now (+2347048812719)</a>
      </p>

      <div class="flex items-center gap-6">
        <a href="/privacy-policy" class="hover:text-[#FFFFFF] transition-colors focus-visible:outline-none">
          Privacy Policy
        </a>
        <span class="text-[#C9A24A]/40">|</span>
        <a href="/terms" class="hover:text-[#FFFFFF] transition-colors focus-visible:outline-none">
          Terms &amp; Conditions
        </a>
      </div>
    </div>
  </div>
</footer>
