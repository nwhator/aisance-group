---
interface Props {
  variant?: 'light' | 'dark';
  className?: string;
}

const { variant = 'light', className = 'h-10 w-auto' } = Astro.props;
const textColor = variant === 'dark' ? '#F7F5EF' : '#12372A';
---

<a href="/" class={`inline-flex items-center gap-3 group focus:outline-none ${className}`} aria-label="Aisance Group Home">
  <svg class="h-10 w-auto flex-shrink-0" viewBox="0 0 320 80" fill="none" xmlns="http://www.w3.org/2000/svg">
    <g transform="translate(10, 8)">
      <!-- Monogram Circle Crest -->
      <rect width="64" height="64" rx="14" fill="#12372A" />
      <circle cx="32" cy="32" r="30" stroke="#C9A24A" stroke-width="1.2" stroke-dasharray="2 3" opacity="0.6" />
      <!-- Stylized Leaf & 'A' Monogram in Champagne Gold -->
      <path d="M32 14 L20 48 H27 L29.5 41 H34.5 L37 48 H44 L32 14 Z M30.8 36 L32 25 L33.2 36 H30.8 Z" fill="#C9A24A" />
      <!-- Organic Leaf swoop weaving into the 'A' crossbar -->
      <path d="M26 38 C 28 32, 36 30, 42 22 C 40 32, 33 38, 26 38 Z" fill="#EAD8A4" opacity="0.9" />
      <circle cx="32" cy="13" r="2" fill="#C9A24A" />
    </g>
    <!-- Brand Wordmark -->
    <text x="88" y="42" font-family="'Cormorant Garamond', Georgia, serif" font-size="28" font-weight="700" letter-spacing="0.18em" fill={textColor}>AISANCE</text>
    <text x="89" y="60" font-family="'Montserrat', sans-serif" font-size="10.5" font-weight="600" letter-spacing="0.32em" fill="#C9A24A">GROUP</text>
  </svg>
</a>
