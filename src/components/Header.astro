---
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const services = [
  { name: 'Toiletries Production', href: '/services/toiletries-production', desc: 'Organic formulations & botanical apothecary' },
  { name: 'Home & Commercial Cleaning', href: '/services/cleaning', desc: 'Hospital-grade sanitation & estate upkeep' },
  { name: 'Dry Cleaning Services', href: '/services/dry-cleaning', desc: 'Master fabric restoration & couture care' },
  { name: 'Food Thrift', href: '/services/food-thrift', desc: 'Farm-direct wholesale staples & pantry curation' },
  { name: 'Errand & Logistics', href: '/services/errand-logistics', desc: 'Discreet corporate transit & VIP courier' },
];

const isServiceActive = currentPath.startsWith('/services');
---

<header class="fixed top-0 left-0 right-0 z-40 bg-[#F7F5EF]/95 backdrop-blur-md border-b border-[#DDE7E1] shadow-[0_12px_32px_-8px_rgba(18,55,42,0.06)]">
  <div class="h-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 flex items-center justify-between gap-4 sm:gap-6">
    <!-- Brand Logo -->
    <Logo variant="light" className="h-10 w-auto" />

    <!-- Desktop Primary Navigation (Strict 5 items max) -->
    <nav class="hidden lg:flex items-center gap-7 xl:gap-9" aria-label="Main Navigation">
      <a
        href="/"
        class={`font-sans text-xs uppercase tracking-wider py-2 font-semibold transition-colors focus-visible:outline-none ${
          currentPath === '/' ? 'text-[#12372A] border-b-2 border-[#C9A24A]' : 'text-[#414844] hover:text-[#12372A]'
        }`}
      >
        Home
      </a>

      <a
        href="/about"
        class={`font-sans text-xs uppercase tracking-wider py-2 font-semibold transition-colors focus-visible:outline-none ${
          currentPath === '/about' ? 'text-[#12372A] border-b-2 border-[#C9A24A]' : 'text-[#414844] hover:text-[#12372A]'
        }`}
      >
        About
      </a>

      <!-- Services Dropdown with Full Keyboard & Click Access -->
      <div class="relative group/dropdown" id="services-dropdown-container">
        <button
          type="button"
          id="services-menu-button"
          class={`font-sans text-xs uppercase tracking-wider py-2 font-semibold transition-colors flex items-center gap-1 focus-visible:outline-none ${
            isServiceActive ? 'text-[#12372A] border-b-2 border-[#C9A24A]' : 'text-[#414844] hover:text-[#12372A]'
          }`}
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="services-menu"
        >
          <span>Services</span>
          <span class="material-symbols-outlined text-[18px] transition-transform duration-200" id="services-dropdown-arrow">expand_more</span>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="services-menu"
          class="hidden group-hover/dropdown:block group-focus-within/dropdown:block absolute top-full left-0 w-80 bg-[#FCF9F8] rounded-xl shadow-[0_16px_36px_-8px_rgba(18,55,42,0.15)] border border-[#DDE7E1] p-2 mt-1 z-50 transition-all duration-200"
          role="menu"
          aria-labelledby="services-menu-button"
        >
          <div class="px-4 py-2 border-b border-[#DDE7E1]/80 mb-1 flex items-center justify-between">
            <span class="font-sans text-[10px] uppercase tracking-widest text-[#C9A24A] font-bold">Specialized Divisions</span>
            <a href="/services" class="font-sans text-[11px] font-semibold text-[#12372A] hover:text-[#C9A24A] flex items-center gap-1">
              <span>View All</span>
              <span class="material-symbols-outlined text-xs">arrow_forward</span>
            </a>
          </div>

          <div class="flex flex-col gap-1">
            {services.map((service, idx) => (
              <a
                href={service.href}
                class={`px-3 py-2.5 rounded-lg transition-colors flex items-start gap-3 group/item focus-visible:outline-none ${
                  currentPath === service.href ? 'bg-[#F0EDED] text-[#12372A]' : 'hover:bg-[#F6F3F2]'
                }`}
                role="menuitem"
              >
                <span class="font-sans text-xs font-bold text-[#C9A24A] mt-0.5">0{idx + 1}</span>
                <div class="flex flex-col">
                  <span class="font-sans text-xs font-semibold text-[#12372A] group-hover/item:text-[#C9A24A] transition-colors">
                    {service.name}
                  </span>
                  <span class="font-sans text-[11px] text-[#414844] leading-tight mt-0.5">
                    {service.desc}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a
        href="/why-aisance"
        class={`font-sans text-xs uppercase tracking-wider py-2 font-semibold transition-colors focus-visible:outline-none ${
          currentPath === '/why-aisance' ? 'text-[#12372A] border-b-2 border-[#C9A24A]' : 'text-[#414844] hover:text-[#12372A]'
        }`}
      >
        Why Aisance
      </a>

      <a
        href="/contact"
        class={`font-sans text-xs uppercase tracking-wider py-2 font-semibold transition-colors focus-visible:outline-none ${
          currentPath === '/contact' ? 'text-[#12372A] border-b-2 border-[#C9A24A]' : 'text-[#414844] hover:text-[#12372A]'
        }`}
      >
        Contact
      </a>
    </nav>

    <!-- Header Actions (Call & Primary CTA) -->
    <div class="flex items-center gap-4">
      <a
        href="tel:08141937193"
        class="hidden xl:flex items-center gap-1.5 text-[#12372A] font-sans text-xs uppercase tracking-wider px-2 py-2 hover:text-[#C9A24A] transition-colors focus-visible:outline-none"
        aria-label="Call Aisance Group at 08141937193"
      >
        <span class="material-symbols-outlined text-[18px] text-[#C9A24A]">call</span>
        <span class="font-semibold">08141937193</span>
      </a>

      <a
        href="/request-service"
        class="hidden sm:inline-flex items-center justify-center bg-[#12372A] text-[#F7F5EF] font-sans text-xs uppercase tracking-widest px-5 py-2.5 rounded-lg border border-[#C9A24A]/50 hover:bg-[#1a4a39] hover:border-[#C9A24A] transition-all shadow-[0_4px_16px_rgba(18,55,42,0.12)] font-bold active:scale-[0.98]"
      >
        Request a Service
      </a>

      <!-- Mobile Menu Hamburger Button -->
      <button
        type="button"
        id="open-mobile-menu"
        class="lg:hidden p-2 rounded-lg text-[#12372A] hover:bg-[#F0EDED] transition-colors focus-visible:outline-none"
        aria-label="Open Navigation Menu"
        aria-controls="mobile-menu-drawer"
      >
        <span class="material-symbols-outlined text-2xl">menu</span>
      </button>
    </div>
  </div>
</header>

<MobileMenu currentPath={currentPath} />

<script>
  function setupDesktopDropdown() {
    const btn = document.getElementById('services-menu-button');
    const menu = document.getElementById('services-menu');
    const container = document.getElementById('services-dropdown-container');
    const arrow = document.getElementById('services-dropdown-arrow');

    if (!btn || !menu || !container) return;

    function toggleMenu(forceState?: boolean) {
      const isExpanded = forceState !== undefined ? !forceState : btn?.getAttribute('aria-expanded') === 'true';
      const newState = !isExpanded;
      btn?.setAttribute('aria-expanded', String(newState));
      if (newState) {
        menu?.classList.remove('hidden');
        arrow?.classList.add('rotate-180');
      } else {
        menu?.classList.add('hidden');
        arrow?.classList.remove('rotate-180');
      }
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    // Keyboard support: Escape closes dropdown
    container.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleMenu(false);
        btn.focus();
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target as Node)) {
        btn.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
        arrow?.classList.remove('rotate-180');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDesktopDropdown);
  } else {
    setupDesktopDropdown();
  }
</script>
